{
  "name": "personal-toolbox",
  "version": "0.4.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && npm run build:electron && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis",
    "format": "prettier --write src electron tests *.ts *.json *.cjs README.md index.html"
  },
  "dependencies": {
    "imapflow": "^2.11.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.personaltoolbox.desktop",
    "productName": "Personal Toolbox",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
